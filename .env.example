# ==============================================================================
# YouTube Automation Studio - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust the values for your local environment.
# NEVER commit the actual .env file or real secrets into version control.

# Application Environment & Server Settings
NODE_ENV=development
PORT=3000
WEB_ORIGIN=http://localhost:5173
API_BASE_URL=http://localhost:3000

# Database Configuration (MySQL 8.x / MariaDB)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=youtube_automation
DB_SYNCHRONIZE=false
DB_LOGGING=true

# Local Media Storage Root Directory
STORAGE_ROOT=./storage

# AI Script & Metadata Provider Configuration
# Supported providers: mock | openai | anthropic
TEXT_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Text-To-Speech (TTS) Provider Configuration
# Supported providers: mock | elevenlabs | local
TTS_PROVIDER=mock
TTS_API_KEY=
TTS_VOICE_ID=

# YouTube Data API v3 & OAuth 2.0 Credentials
# Google Cloud Console OAuth 2.0 Client Credentials
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3000/api/youtube/oauth/callback

# 32-byte hex-encoded key for AES-256-GCM encryption of stored OAuth tokens
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
YOUTUBE_TOKEN_ENCRYPTION_KEY=

# System Safety & Feature Flags
# Controls whether real external AI / Cloud APIs can be invoked
ENABLE_EXTERNAL_API_CALLS=false

# Controls whether actual uploads to YouTube are permitted
ENABLE_YOUTUBE_UPLOADS=false

# Hard safety gate: public publishing is disabled in MVP (strictly private uploads only)
ENABLE_PUBLIC_RELEASE=false

# FFmpeg Executable Paths (Optional: specify if not available in system PATH)
FFMPEG_PATH=C:\WINDOWS\system32\ffmpeg.exe
FFPROBE_PATH=
